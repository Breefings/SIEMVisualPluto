# Copy to .env and fill in. The app works without a key (offline rule engine).
ANTHROPIC_API_KEY=
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max
# PORT=8000
# PIPER_PATH=C:\path\to\piper.exe
# PIPER_VOICES=C:\path\to\voices
# RENDER_SCALE=1               # 1080p MP4 export (default 0.667 = 720p, faster)
